{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markoblogo.github.io/pictiq/spec/pictiq-message.schema.json",
  "title": "Pictiq Message Format v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pictiq", "frames"],
  "properties": {
    "schema": {
      "description": "Pictiq Message Schema version.",
      "const": "0.1"
    },
    "pictiq": {
      "description": "Target Pictiq language/protocol compatibility version. v1.1.0 is represented as 1.1 for this schema family.",
      "const": "1.1"
    },
    "profile": {
      "description": "Optional authoring/validation profile. Rendering an otherwise valid canonical token does not depend on profile membership.",
      "enum": ["embodied", "standalone", "embodied-core-v0.1", "standalone-core-v0.1"]
    },
    "contexts": {
      "description": "Optional ordered context/pack declarations. These guide palette, validation, interpretation, provenance, and translation.",
      "type": "array",
      "items": {
        "enum": ["universal-core", "universal-v1", "city-paris-v0.1", "road-wayfinding-v0.1", "narrative", "odyssey"]
      },
      "uniqueItems": true
    },
    "frames": {
      "description": "Ordered semantic frames. A v0.1 frame is a flat ordered token sequence.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "token": {
      "oneOf": [
        { "$ref": "#/$defs/iconToken" },
        { "$ref": "#/$defs/entityToken" },
        { "$ref": "#/$defs/numberToken" }
      ]
    },
    "iconToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "icon" },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "description": "Token-local COLOR parameter as six-digit sRGB hex.",
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "minProperties": 1
        }
      }
    },
    "entityToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "entity" },
        "id": {
          "type": "string",
          "pattern": "^entity:[a-z0-9]+(?:-[a-z0-9]+)*@[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "numberToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "number" },
        "value": {
          "description": "Exact non-negative integer numeric notation value. Registry-aware v0.1 validation currently supports only implemented numeric renderings such as 50.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    }
  }
}
